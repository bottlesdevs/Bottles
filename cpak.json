{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Bottles",
  "description": "Run and manage your Windows applications on Linux with Wine and Proton.",
  "version": "67.4",
  "image": "ghcr.io/bottlesdevs/bottles@sha256:01f8246ce273a494e436f92a2e841ea6de9d77b901c0b493260c3c1d7e292d09",
  "binaries": [
    "/usr/bin/bottles",
    "/usr/bin/bottles-cli"
  ],
  "desktop_entries": [
    "/usr/share/applications/com.usebottles.bottles.desktop"
  ],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "displayX11": true,
    "clipboard": {
      "hostToApp": true,
      "appToHost": true
    },
    "socketWayland": true,
    "socketPulseAudio": true,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "bluetooth": false,
    "deviceDri": false,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": true,
    "notification": true,
    "openURI": true,
    "hostApplications": false,
    "filePicker": {
      "openFile": true,
      "openFolder": true,
      "saveFile": true,
      "persistent": true,
      "containingFolder": true
    },
    "filesystem": [
      {
        "path": "home/.local/share/bottles",
        "access": "read-write"
      },
      {
        "path": "home/.local/share/icons",
        "access": "read-write"
      }
    ],
    "env": [
      "PATH=/app/bin:/usr/bin:/usr/local/bin:/usr/lib/extensions/vulkan/MangoHud/bin/:/usr/lib/extensions/vulkan/OBSVkCapture/bin/:/usr/lib/extensions/vulkan/gamescope/bin/",
      "LD_LIBRARY_PATH=/app/lib:/app/lib/i386-linux-gnu:/usr/lib:/usr/lib/aarch64-linux-gnu:/usr/lib/x86_64-linux-gnu",
      "GST_PLUGIN_SYSTEM_PATH=/app/lib/gstreamer-1.0:/usr/lib/aarch64-linux-gnu/gstreamer-1.0:/usr/lib/x86_64-linux-gnu/gstreamer-1.0:/usr/lib/i386-linux-gnu/gstreamer-1.0",
      "GSETTINGS_BACKEND=keyfile"
    ],
    "network": true,
    "process": false,
    "userNamespaces": true,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
