{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Bottles",
  "description": "Run and manage your Windows applications on Linux with Wine and Proton.",
  "version": "66.9",
  "image": "ghcr.io/bottlesdevs/bottles@sha256:0b137d779c10a48c5ffffc932a7844468ae0f41692deb76313df684a324777f2",
  "binaries": [
    "/usr/bin/bottles",
    "/usr/bin/bottles-cli"
  ],
  "desktop_entries": [
    "/usr/share/applications/com.usebottles.bottles.desktop"
  ],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "socketWayland": true,
    "socketPulseAudio": true,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "deviceDri": false,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceAll": true,
    "notification": true,
    "openURI": true,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [
      "PATH=/app/bin:/usr/bin:/usr/local/bin:/usr/lib/extensions/vulkan/MangoHud/bin/:/usr/lib/extensions/vulkan/OBSVkCapture/bin/:/usr/lib/extensions/vulkan/gamescope/bin/",
      "LD_LIBRARY_PATH=/app/lib:/app/lib/i386-linux-gnu:/usr/lib",
      "GST_PLUGIN_SYSTEM_PATH=/app/lib/gstreamer-1.0:/usr/lib/x86_64-linux-gnu/gstreamer-1.0:/usr/lib/i386-linux-gnu/gstreamer-1.0"
    ],
    "network": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
