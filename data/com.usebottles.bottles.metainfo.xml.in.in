<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <id>@APP_ID@</id>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <name>Bottles</name>
  <summary>Run Windows software</summary>
  <developer id="@DEVELOPER_ID@">
    <name translate="no">The Bottles Contributors</name>
  </developer>
  <categories>
    <category>Utility</category>
    <category>Game</category>
    <category>Graphics</category>
    <category>3DGraphics</category>
    <category>Emulator</category>
    <category>GNOME</category>
    <category>GTK</category>
  </categories>
  <branding>
    <color type="primary" scheme_preference="light">#f4c8cb</color>
    <color type="primary" scheme_preference="dark">#892119</color>
  </branding>
  <description>
    <p>Bottles lets you run Windows software on Linux, such as applications and games. It introduces a workflow that helps you organize by categorizing each software to your liking. Bottles provides several tools and integrations to help you manage and optimize your applications.</p>
    <p>Features:</p>
    <ul>
      <li>Use pre-configured environments as a base</li>
      <li>Change runners for any bottle</li>
      <li>Various optimizations and options for gaming</li>
      <li>Repair in case software or bottle is broken</li>
      <li>Install various known dependencies</li>
      <li>Integrated task manager to manage and monitor processes</li>
      <li>Backup and restore</li>
    </ul>
  </description>
  <provides>
    <mediatype>application/x-ms-dos-executable</mediatype>
    <mediatype>application/x-msi</mediatype>
    <mediatype>application/x-ms-shortcut</mediatype>
    <mediatype>application/x-wine-extension-msp</mediatype>
  </provides>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/bottlesdevs/Bottles/main/data/screenshots/1.png</image>
      <caption>Bottles List Page</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/bottlesdevs/Bottles/main/data/screenshots/2.png</image>
      <caption>Library Page</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/bottlesdevs/Bottles/main/data/screenshots/3.png</image>
      <caption>Create New Bottle</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/bottlesdevs/Bottles/main/data/screenshots/4.png</image>
      <caption>Bottle Details Page</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/bottlesdevs/Bottles/main/data/screenshots/5.png</image>
      <caption>Bottle Settings Page</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/bottlesdevs/Bottles/main/data/screenshots/6.png</image>
      <caption>Installers Page</caption>
    </screenshot>
  </screenshots>
  <translation type="gettext">com.usebottles.bottles</translation>
  <content_rating type="oars-1.1"/>
  <url type="homepage">https://usebottles.com</url>
  <url type="bugtracker">https://github.com/bottlesdevs/Bottles/issues</url>
  <url type="help">https://docs.usebottles.com</url>
  <url type="donation">https://usebottles.com/funding</url>
  <url type="translate">https://hosted.weblate.org/engage/bottles</url>
  <url type="vcs-browser">https://github.com/bottlesdevs/Bottles</url>
  <url type="contribute">https://github.com/bottlesdevs/Bottles/blob/main/CONTRIBUTING.md</url>
  <recommends>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </recommends>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
  <releases>
    <release version="67.3" date="2026-09-07">
      <description translate="no">
        <ul>
          <li>Restored Flatpak compatibility for 32-bit runners and media codecs</li>
          <li>Fixed Steam runtime launches when the runtime path uses a symbolic link</li>
          <li>Fixed opening selected directories from the Flatpak package</li>
          <li>Added the ARM64 Cpak package with Soda runner support</li>
          <li>Hidden the component update section when no updates are available</li>
        </ul>
      </description>
    </release>
    <release version="67.2" date="2026-09-03">
      <description translate="no">
        <ul>
          <li>Fixed Proton font links not being refreshed after runner updates</li>
          <li>Fixed the UMU dedicated sandbox exposing the host filesystem read-only</li>
          <li>Fixed installer icons failing to load from hosts that reject anonymous requests</li>
          <li>Added card and Revolut donation options to the funding dialog</li>
          <li>Shared files granted through the Cpak file chooser with the dedicated sandbox</li>
          <li>Restricted the Cpak filesystem access to Bottles data</li>
        </ul>
      </description>
    </release>
    <release version="67.1" date="2026-09-02">
      <description translate="no">
        <ul>
          <li>Fixed UMU runtime preparation inside the dedicated sandbox</li>
          <li>Fixed SteamRT4 and ProtoSoda startup inside the Cpak sandbox</li>
          <li>Restored persistent settings in Cpak without a session D-Bus</li>
          <li>Restored the add menu for creating bottles and installing UMU games</li>
          <li>Restored disabled command arguments in program launch options</li>
          <li>Added an opt-in network permission for sandboxed UMU games</li>
        </ul>
      </description>
    </release>
    <release version="67.0" date="2026-08-31">
      <description translate="no">
        <ul>
          <li>Enabled Soda 11.0-7 with Adaptive Launch sessions and host OpenXR</li>
          <li>Added ProtoSoda 11.0-2 with Adaptive Launch support through UMU</li>
          <li>Added ARM64 Soda runner selection through the component catalog</li>
          <li>Added a single action for adding or removing programs from the Library</li>
          <li>Sorted Library entries by name</li>
          <li>Fixed running programs restarting when opening unchanged synchronization settings</li>
        </ul>
      </description>
    </release>
    <release version="66.11" date="2026-08-31">
      <description translate="no">
        <ul>
          <li>Added per-session Adaptive Launch learning for Soda runners</li>
          <li>Added host OpenXR support for 64-bit Windows applications outside Steam</li>
          <li>Added ARM64 Soda runners with bundled FEX support</li>
          <li>Fixed platform-specific component selection and bundled FEX detection</li>
          <li>Fixed UMU dedicated sandbox access to managed Proton runners</li>
          <li>Fixed custom MangoHud configurations when system environment variables are limited</li>
        </ul>
      </description>
    </release>
    <release version="66.10" date="2026-08-29">
      <description translate="no">
        <ul>
          <li>Added dedicated sandboxing for UMU prefixes</li>
          <li>Added automatic local cover detection and improved Library card states</li>
          <li>Improved runner loading, including locally installed runners while offline</li>
          <li>Fixed component selectors after bottle creation and program refresh after executable discovery</li>
          <li>Hidden the offline warning when offline mode is enabled explicitly</li>
          <li>Replaced the retired connectivity endpoint and added IPv4 fallback</li>
          <li>Updated the official cpak package to manifest v3 with bundled UMU</li>
        </ul>
      </description>
    </release>
    <release version="66.9" date="2026-08-26">
      <description translate="no">
        <ul>
          <li>Fixed the Stop action for games launched from the Library</li>
          <li>Fixed opening custom bottle folders</li>
          <li>Fixed steamuser profile aliases when the home directory is a symbolic link</li>
          <li>Added dconf and xz to the cpak runtime</li>
        </ul>
      </description>
    </release>
    <release version="66.8" date="2026-08-22">
      <description translate="no">
        <ul>
          <li>Improved Library cards and added desktop and Steam shortcuts for UMU games</li>
          <li>Fixed Preferences windows accumulating and slowing down the application</li>
          <li>Fixed D7VK selections appearing to reset until Bottles was restarted</li>
          <li>Fixed dependency downloads from servers that reject HEAD requests</li>
          <li>Accepted managed Proton runners during the first-run setup</li>
          <li>Delayed UMU directory creation until UMU is used</li>
          <li>Removed unused Library covers after their final entry is deleted</li>
          <li>Fixed shutdown and reboot actions, cursor sizing and platform-specific runner visibility</li>
        </ul>
      </description>
    </release>
    <release version="66.7" date="2026-08-16">
      <description translate="no">
        <ul>
          <li>Fixed duplicate bottles overwriting existing copies or leaving partial data after errors</li>
          <li>Fixed the bottle list not refreshing after deletion</li>
          <li>Fixed repository timeouts on networks with broken IPv6 resolution</li>
          <li>Fixed UMU runtime access in the Flathub package</li>
        </ul>
      </description>
    </release>
    <release version="66.6" date="2026-08-14">
      <description translate="no">
        <ul>
          <li>Fixed deleting bottles that use a dedicated sandbox</li>
        </ul>
      </description>
    </release>
    <release version="66.5" date="2026-08-13">
      <description translate="no">
        <ul>
          <li>Made dependency rows select entries for batch installation</li>
          <li>Fixed detection of Proton runners whose catalog names include the architecture</li>
          <li>Clarified the Steam Runtime recommendation for external Proton runners</li>
        </ul>
      </description>
    </release>
    <release version="66.4" date="2026-08-13">
      <description translate="no">
        <ul>
          <li>Fixed dependency installation after case-insensitive DLL replacement</li>
        </ul>
      </description>
    </release>
    <release version="66.3" date="2026-08-13">
      <description translate="no">
        <ul>
          <li>Fixed launching external executables when the Z: drive is disabled</li>
        </ul>
      </description>
    </release>
    <release version="66.2" date="2026-08-13">
      <description translate="no">
        <ul>
          <li>Fixed Steam Runtime arguments and Scout runtime launches</li>
          <li>Fixed mixed Library entries and case-insensitive DLL duplicates</li>
          <li>Fixed NVK detection when the preferred ICD is unavailable</li>
          <li>Fixed launching external executables with Wine</li>
          <li>Prevented installer and crash report network requests from blocking the interface</li>
          <li>Improved funding controls and kept dialogs attached to the main window</li>
        </ul>
      </description>
    </release>
    <release version="66.1" date="2026-08-12">
      <description translate="no">
        <ul>
          <li>Fixed Flatpak runner paths when launching applications through Steam Runtime</li>
          <li>Fixed selecting an existing executable for custom UMU prefixes</li>
        </ul>
      </description>
    </release>
    <release version="66.0" date="2026-08-11">
      <description translate="no">
        <ul>
          <li>Integrated UMU with Library-managed games, prefixes, per-game Proton settings, dependencies and command line support</li>
          <li>Added ProtoSoda as the default UMU runner with the Soda compatibility work in a Proton environment</li>
          <li>Added Adaptive Launch profiling for bottles using Soda 11.0-5 or newer</li>
          <li>Added an experimental official cpak package built from the Bottles source tree and release tags</li>
          <li>Added official runner logos and bundled the symbolic icons required by the interface</li>
          <li>Improved runner and graphics component updates with a shared bulk update flow</li>
          <li>Added Steam Linux Runtime 4 support for Proton 11 and synchronized its VKD3D utilities</li>
          <li>Fixed bottle creation and preferences failing with incomplete templates, multiple profiles or unavailable GameMode</li>
          <li>Fixed dependency reinstall and limited uninstall to recipes that provide a real uninstaller</li>
          <li>Fixed custom bottle creation when selecting the configured default directory</li>
          <li>Fixed GameMode, MangoHud and other host wrappers used with Steam Runtime</li>
          <li>Fixed program icons, Library covers, cabinet wildcards, SOCKS proxies and cover picker paths</li>
          <li>Fixed Flatpak add-on commands, NVK detection and onboarding without an installed Wine runner</li>
        </ul>
      </description>
    </release>
    <release version="65.4" date="2026-08-06">
      <description translate="no">
        <ul>
          <li>Fixed bottle creation failing when the template carried separate user profiles</li>
        </ul>
      </description>
    </release>
    <release version="65.3" date="2026-08-06">
      <description translate="no">
        <ul>
          <li>Fixed bottle creation when DXVK or a runner has not been downloaded yet</li>
          <li>Fixed the dependencies list freezing the interface and failing to list installed dependencies</li>
          <li>Fixed bottle pages turning blank after a cancelled back gesture</li>
          <li>Fixed the bottle deletion dialog closing while the view was already changing</li>
        </ul>
      </description>
    </release>
    <release version="65.2" date="2026-08-05">
      <description translate="no">
        <ul>
          <li>Added Steam Linux Runtime 4 support for Proton 11 and newer runners</li>
          <li>Fixed programs being launched as Steam applications when using Proton based runners</li>
        </ul>
      </description>
    </release>
    <release version="65.1" date="2026-08-04">
      <description translate="no">
        <ul>
          <li>Fixed bottle preferences failing to initialize when GameMode is unavailable</li>
        </ul>
      </description>
    </release>
    <release version="65.0" date="2026-08-04">
      <description translate="no">
        <ul>
          <li>Added Eagle Intelligence with credited and licensed compatibility data from ProtonDB and winetricks</li>
          <li>Added community-backed environment variables, DLL overrides, launch arguments, compatibility ratings and configurable recommendations to Eagle results</li>
          <li>Added D7VK as a managed component for Direct3D 3, 5, 6 and 7 applications</li>
          <li>Added automatic backups for selected program files and folders after the program closes</li>
          <li>Added a per-bottle frame rate limiter for DXVK and VKD3D applications</li>
          <li>Added HOTAS and HIDRAW device selection with runner compatibility warnings</li>
          <li>Added input and USB device sharing controls to dedicated sandboxes</li>
          <li>Added lsfg-vk frame generation with private handling for the user-provided Lossless Scaling DLL</li>
          <li>Added sandbox configuration during bottle creation</li>
          <li>Added application language and text scaling controls</li>
          <li>Added Steam games to the library and discovery for Steam Proton runners and shortcut prefixes</li>
          <li>Added custom library covers, bottle ordering, file associations and program launch at login</li>
          <li>Added selected dependency installation and CLI bottle setup</li>
          <li>Added controls to hide console windows and component update suggestions</li>
          <li>Added support for configuring the default Z drive</li>
          <li>Added NTSync runner detection and HDR launch configuration</li>
          <li>Fixed startup failures caused by lowercase or unsupported LOG_LEVEL values</li>
          <li>Fixed hidden files being omitted from bottle duplicates</li>
          <li>Fixed missing paths breaking bottle versioning and restoration</li>
          <li>Fixed malformed environment variables and unavailable process environments causing crashes</li>
          <li>Fixed bottle creation failures caused by invalid recipes, templates and Windows version changes</li>
          <li>Fixed desktop entries after program renames, removals and Flatpak launches</li>
          <li>Fixed drive mappings, external prefix imports and shared Wine user profiles</li>
          <li>Fixed Steam game discovery, runtime selection and shortcut launch options</li>
          <li>Fixed document portal paths for shortcuts, custom bottle directories and folder access</li>
          <li>Fixed cached component installation and repository failover when offline</li>
          <li>Fixed application installers not refreshing the programs list after completion</li>
          <li>Fixed Wine Mono prompts during wineboot and incompatible system Wine detection</li>
          <li>Fixed MangoHud configuration inheritance and NVK Vulkan driver detection</li>
          <li>Fixed imported bottle configuration, library icons and renamed Epic games</li>
          <li>Updated issue reporting checks and documentation for stable Flatpak builds</li>
        </ul>
      </description>
    </release>
    <release version="64.1" date="2026-05-30">
      <description translate="no">
        <ul>
          <li>Fixed nothing launching in a dedicated sandbox when the program is stored outside the bottle, Bottles now warns and lets you run it without the sandbox or copy it into the bottle and keep the sandbox on</li>
          <li>Eagle now scans executables for known malware and stealer patterns and warns you before running a flagged program</li>
          <li>Eagle automatically offers to analyze a program when it crashes or closes immediately</li>
          <li>Eagle results now include a security section and a way to support Bottles</li>
          <li>Added settings to control Eagle threat scanning and crash detection</li>
          <li>Added ntsync support</li>
          <li>Added a home card and dialog to update components across all bottles at once</li>
          <li>Added a toggle to enable or disable a program launch arguments</li>
          <li>MANGOHUD_CONFIG is now inherited from the host environment by default</li>
          <li>Bottles now logs an environment summary when launched from a terminal</li>
          <li>The bottles list now shows an offline banner and refreshes components when the connection returns</li>
          <li>Bottles now warns when a bottle location is offline instead of silently hiding it</li>
          <li>Fixed drastically slow startup and UI freezes with many programs or library entries</li>
          <li>Fixed app names with spaces breaking the desktop entry links</li>
          <li>Fixed desktop entry creation on KDE and Wayland</li>
          <li>Fixed the desktop entry category and sanitized the bottle name in the entry filename</li>
          <li>Fixed the lowercase executable name used for StartupWMClass</li>
          <li>Fixed Manager startup side effects during CLI launches</li>
          <li>Fixed stopping processes running inside a dedicated sandbox</li>
          <li>Fixed the Steam Runtime being left enabled when switching to a non-Proton runner</li>
          <li>Fixed incorrect runner update suggestions across runner variants</li>
          <li>Fixed bottle creation aborting when optional components such as NVAPI or LatencyFleX were unavailable</li>
          <li>Fixed the CLI being forced offline so bottle creation can fetch components</li>
          <li>Fixed runners and DLLs not listing in preferences when offline</li>
          <li>Fixed the connectivity check hanging the first setup</li>
          <li>Fixed reusing an already downloaded dependency regardless of its filename case</li>
          <li>Fixed Gamescope not working with the dedicated sandbox</li>
          <li>Fixed exposing the Proton runner path and runtime to the dedicated sandbox</li>
          <li>Fixed transient document portal paths breaking custom bottle directories and shortcuts</li>
          <li>Fixed FVS repositories using a larger block size to avoid huge file counts</li>
          <li>Fixed transient files being copied when caching a bottle template</li>
          <li>Fixed session idle not being inhibited while a program is running, so the screen no longer blanks</li>
          <li>Fixed the bottle language encoding to default to UTF-8</li>
          <li>Fixed program names with symbols such as ampersand not rendering correctly</li>
          <li>Fixed the dependencies search not resetting when the entry is cleared</li>
          <li>Fixed the snapshot list not refreshing after restoring a state</li>
          <li>Fixed the bottles list not refreshing after deleting the last bottle</li>
          <li>Fixed being able to skip the welcome steps by swiping</li>
          <li>Use an env based shebang for the standalone script</li>
          <li>Dropped deprecated variables</li>
        </ul>
      </description>
    </release>
    <release version="64.0" date="2026-05-29">
      <description translate="no">
        <ul>
          <li>Eagle now scans executables for known malware and stealer patterns and warns you before running a flagged program</li>
          <li>Eagle automatically offers to analyze a program when it crashes or closes immediately</li>
